# Drip environment variables
#
# Copy this file to `.env.local` and fill in the values. `.env.local` is ignored
# by git, so keys never end up in the repository. Never put keys in the code.
#
# With none of these set, Drip runs in device-only mode (no accounts).
# DEPLOY.md explains where each value comes from.

# Who runs Drip, shown on /privacy and /terms. Set in the host's settings, so
# personal details stay out of the repository. Redeploy after changing them.
LEGAL_OWNER_NAME=
LEGAL_CONTACT_EMAIL=
# Postal address: EU consumer law requires it once you sell Pro.
LEGAL_ADDRESS=

# Accounts and cloud database (Supabase: Project Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses row-level security: never expose it to the browser.
SUPABASE_SECRET_KEY=
#
# The site's public address, used in reminder emails (e.g. https://drip.example.com)
NEXT_PUBLIC_SITE_URL=

# Reminders: the daily job at /api/cron/reminders only runs with this secret.
# Any long random string. Vercel Cron sends it automatically.
CRON_SECRET=

# Reminder emails through Resend (resend.com -> API Keys)
RESEND_API_KEY=
# Sender, on a domain you verified in Resend, e.g. Drip <reminders@yourdomain.com>
REMINDER_FROM_EMAIL=

# Phone/desktop notifications. Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:you@example.com
VAPID_SUBJECT=
#
# Payments with Stripe (dashboard.stripe.com -> Developers -> API keys).
# Then run `npm run stripe:setup` once to create the Pro prices and the webhook.
STRIPE_SECRET_KEY=
# Printed by `npm run stripe:setup` (or Developers -> Webhooks -> your endpoint)
STRIPE_WEBHOOK_SECRET=
# Set to true once Stripe is set up: shows "Upgrade" instead of the free Pro preview
NEXT_PUBLIC_PAYMENTS_ENABLED=false
# true = Stripe is the merchant of record (Managed Payments) and handles VAT everywhere, for an
# extra fee. Accept its terms first (Stripe dashboard -> Settings -> Managed Payments).
STRIPE_MANAGED_PAYMENTS=false

# Live bank connections through Enable Banking (DEPLOY.md, step 6).
# The application ID is the name of the .pem file the Control Panel downloads
# (without ".pem"); the private key is that file's contents, BEGIN/END lines included.
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY=
# Set to true once the two above are set: shows "Connect your bank" in the app
NEXT_PUBLIC_BANK_ENABLED=false

# Android app from PWABuilder (DEPLOY.md, step 7): enables /.well-known/assetlinks.json
ANDROID_PACKAGE_NAME=
# SHA-256 signing key fingerprint(s), comma-separated
ANDROID_CERT_FINGERPRINTS=
